# Optional local environment variables for book_project_olena.
# The current settings file does not load this file automatically.
# Use these as shell environment variables or load them with your own local tooling.

# Optional PostgreSQL database alias.
# SQLite remains the default database unless config/settings.py is changed further.
BOOKS_ENABLE_POSTGRES=0
POSTGRES_DB=books
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
